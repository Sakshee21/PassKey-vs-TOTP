# PostgreSQL
POSTGRES_USER=passkey_user
POSTGRES_PASSWORD=passkey_pass
POSTGRES_DB=passkey_vs_totp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://passkey_user:passkey_pass@localhost:5432/passkey_vs_totp

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PassKey vs TOTP
WEBAUTHN_ORIGIN=http://localhost:5173

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# security-demos/attack_sim.py sends this as X-Attack-Sim-Token so its
# traffic gets tagged is_simulated=true in auth_events. Change it to
# anything; just keep this value and attack_sim.py's --sim-token in sync.
ATTACK_SIM_TOKEN=change-me-attack-sim-token
