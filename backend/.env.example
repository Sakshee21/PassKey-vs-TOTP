# PostgreSQL
POSTGRES_USER=passkey_user
POSTGRES_PASSWORD=passkey_pass
POSTGRES_DB=passkey_vs_totp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://passkey_user:passkey_pass@localhost:5432/passkey_vs_totp

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PassKey vs TOTP
WEBAUTHN_ORIGIN=http://localhost:5173

# CORS
FRONTEND_ORIGIN=http://localhost:5173
